+-- Full native player badge, shared by player/target/focus and normal party.
+-- Keep it out of the compact role/leader chain; level text draws above it.
+function UF.CreatePvpBadge(frame)
+    local outer = frame.outerBorderFrame
+    local icon = outer:CreateTexture(nil, "ARTWORK", nil, 2)
+    icon:SetSize(64, 64); icon:Hide()
+    local portrait = outer:CreateTexture(nil, "ARTWORK", nil, 2)
+    portrait:SetSize(50, 52); portrait:Hide()
+    local badge = outer:CreateTexture(nil, "ARTWORK", nil, 3)
+    badge:SetSize(30, 30); badge:Hide()
+    frame.pvpIcon = icon
+    frame._fluxPvpPrestigePortrait, frame._fluxPvpPrestigeBadge = portrait, badge
+    frame._fluxPvpElements = {pvpIcon=icon, prestigePortrait=portrait, prestigeBadge=badge}
+end
+
+function UF.UpdatePvpBadge(frame, layoutOnly)
+    local icon, level = frame.pvpIcon, frame.levelText
+    if not icon or not level then return end
+    -- Native-size art stays behind the level; text remains on the raised layer.
+    icon:ClearAllPoints(); icon:SetPoint("TOP", level, "TOP", 0, 4)
+    icon:SetDrawLayer("ARTWORK", 2)
+    local portrait, badge = frame._fluxPvpPrestigePortrait, frame._fluxPvpPrestigeBadge
+    if portrait then portrait:ClearAllPoints(); portrait:SetPoint("TOP", level, "TOP", 0, 4) end
+    if badge then badge:ClearAllPoints(); badge:SetPoint("CENTER", portrait, "CENTER", 0, 0) end
+    if frame.pvpTimer then
+        frame.pvpTimer:ClearAllPoints(); frame.pvpTimer:SetPoint("TOP", level, "BOTTOM", 0, -2)
+        -- Only the existing player driver can supply a real countdown.
+        if frame.unit ~= "player" then frame.pvpTimer:Hide() end
+    end
+    if layoutOnly then return end
+    local function hide()
+        icon:Hide(); if portrait then portrait:Hide() end; if badge then badge:Hide() end
+    end
+    if frame.unit == "targettarget" or frame.unit == "focustarget" or frame.unit == "pet"
+        or (FluxUnitFrames_ShouldShowPvp and not FluxUnitFrames_ShouldShowPvp(frame.unit)) then
+        hide(); if frame.pvpTimer then frame.pvpTimer:Hide() end; return
+    end
+    if UnitFrameUtil and UnitFrameUtil.UpdateUnitPvPIndicator and frame._fluxPvpElements then
+        UnitFrameUtil.UpdateUnitPvPIndicator(frame._fluxPvpElements, frame.unit, frame.unit == "player")
+        return
+    end
+    if portrait then portrait:Hide() end; if badge then badge:Hide() end
+    local ffa = UnitIsPVPFreeForAll and UnitIsPVPFreeForAll(frame.unit)
+    local pvp = UnitIsPVP and UnitIsPVP(frame.unit)
+    local faction = UnitFactionGroup and UnitFactionGroup(frame.unit)
+    if PvpValueIsSecret(ffa) or PvpValueIsSecret(pvp) or PvpValueIsSecret(faction) then hide(); return end
+    local kind = ffa and "FFA" or pvp and (faction == "Alliance" or faction == "Horde") and faction
+    if not kind then hide(); return end
+    local client = ns.Flux and ns.Flux.Client
+    local modern = client and (client.isRetail or client.isLiveMidnight or client.isForever)
+    local atlas = "UI-HUD-UnitFrame-Player-PVP-" .. kind .. "Icon"
+    local info = modern and C_Texture and C_Texture.GetAtlasInfo and C_Texture.GetAtlasInfo(atlas)
+    icon:SetTexCoord(0, 1, 0, 1)
+    if info and icon.SetAtlas then icon:SetAtlas(atlas, true)
+    else icon:SetTexture("Interface\\TargetingFrame\\UI-PVP-" .. kind); icon:SetSize(64, 64) end
+    icon:Show()
+end
