--- checkpoint/tests/fixtures/alpha_reader_before.txt
+++ applied/tests/fixtures/alpha_reader_before.txt
@@ -0,0 +1,145 @@
+-- Frozen pre-fix production alpha readers, used only as rejection/parity controls.
+-- Captured from the external 2026-11-07 baseline; never loaded by the addon.
+return {
+ ["grid"] = [====[
+function Blizzard.QuietGrid()
+	if Bars.secureReady == false then return end
+	if FluxEditModeBusy and FluxEditModeBusy() then
+		FluxAfterEditMode(Blizzard.QuietGrid)
+		return
+	end
+	local function Dim(frame)
+		if type(frame) == "table" and frame.GetAlpha and frame.SetAlpha and frame:GetAlpha() > 0 then
+			frame:SetAlpha(0)
+		end
+	end
+	for i = 1, Bars.NUM_NATIVE do
+		Dim(Blizzard.GetActionButton(i))
+		Dim(_G["MainActionBarButtonContainer" .. i])
+	end
+	for i = 1, #MULTI_BARS do
+		local bar = _G[MULTI_BARS[i]]
+		if CanReplaceBar(MULTI_BARS[i]) and bar ~= _G.StanceBar and bar ~= _G.PossessActionBar
+			and bar ~= _G.StanceBarFrame and bar ~= _G.PossessBarFrame then
+			Dim(bar)
+		end
+	end
+end
+]====],
+ ["cast"] = [====[
+local function WidgetShown(widget)
+	if not widget or widget._fluxParked then
+		return false
+	end
+	if widget._fluxBadgeCombatVisHidden then
+		return false
+	end
+	if widget.GetAlpha then
+		local ok, a = pcall(widget.GetAlpha, widget)
+		if ok and type(a) == "number" and a <= 0 then
+			return false
+		end
+	end
+	if widget.IsShown and not widget:IsShown() then
+		return false
+	end
+	return true
+end
+
+]====],
+ ["bling"] = [====[
+local function SetBling(cd, on)
+	if not cd or not cd.SetDrawBling then
+		return
+	end
+	if not on then
+		cd:SetDrawBling(false)
+		return
+	end
+	local alpha = 1
+	if cd.GetEffectiveAlpha then
+		local a = cd:GetEffectiveAlpha()
+		if type(a) == "number" then
+			alpha = a
+		end
+	end
+	cd:SetDrawBling(alpha > 0.4)
+end
+
+]====],
+ ["badge"] = [====[
+function BadgeHost.GetVisibleBadgesForButton(button)
+	if not button then
+		return nil
+	end
+	local byBtn = instances[button]
+	if not byBtn then
+		return nil
+	end
+	local host = button._fluxHost
+	local slot = LiveSlotOf(host)
+	if not slot then
+		return nil
+	end
+	local set = byBtn[slot]
+	if not set then
+		return nil
+	end
+	local out = {}
+	local desired = slotBadges[slot]
+	if not desired then
+		return nil
+	end
+	local corner = 0
+	for i = 1, #desired do
+		if ShouldShow(host, slot, desired[i], i) then
+			corner = corner + 1
+			if set[corner] then
+				local badge = set[corner]
+				local w = badge.Widget
+				if w and w._fluxBadgeCombatVisHidden then
+					-- unused / same-face corners stay shown at alpha 0
+				else
+					local alphaOk = true
+					if w and w.GetAlpha then
+						local ok, a = pcall(w.GetAlpha, w)
+						if ok and type(a) == "number" and a <= 0 then
+							alphaOk = false
+						end
+					end
+					if alphaOk then
+						out[#out + 1] = badge
+					end
+				end
+			end
+		end
+	end
+	return #out > 0 and out or nil
+end
+
+]====],
+ ["ring"] = [====[
+local function NormalRingVisible(tex)
+	if not tex then
+		return false
+	end
+	if tex.IsShown and not tex:IsShown() then
+		return false
+	end
+	if tex.GetAlpha then
+		local a = tex:GetAlpha()
+		if type(a) == "number" and a < 0.01 then
+			return false
+		end
+	end
+	if tex.GetTexture then
+		local path = tex:GetTexture()
+		if path == nil or path == false or path == "" then
+			return false
+		end
+	end
+	return true
+end
+
+]====],
+}
