{
  "changeId": "PLAYER-GHOST-HOVER-20261114",
  "date": "2026-11-14",
  "requirements": [
    "Remove the confirmed invisible Blizzard PlayerFrame hover/cast target on every supported client",
    "Preserve native unit/vehicle/aura handlers and independent controls",
    "Respect combat and Edit Mode boundaries; restore native input on Blizzard selection"
  ],
  "userEvidence": "User on Forever identifies PlayerFrame in /framestack and reports interference with unit-frame hover casting.",
  "implementation": [
    "Snapshot and empty native player root hit rectangle outside combat/Edit Mode; exact restoration",
    "Expose existing addon-owned mouse suppression policy through Blizz.IsMouseSuppressed",
    "Exclude suppressed roots/subtrees from both GetMouseFoci and geometric binding fallback scans"
  ],
  "scope": "Three runtime owners; two existing desktop harnesses. No new event/timer/hook/driver, options, strings or saved schema.",
