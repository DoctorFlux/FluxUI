{
  "task": "ACTION-COUNTS-20261113",
  "checkedDate": "2026-11-13",
  "repository": "Gethe/wow-ui-source",
  "method": "GitHub connector GET reads; branch commits resolved once, all file reads commit-pinned; packaged narrow symbol query used for ownership routing only.",
  "scope": "Source declarations and loaded Blizzard Lua/TOC evidence only. No native addon event-registration, delivery, operation, taint, pixels, controller, CPU or FPS acceptance.",
  "contracts": {
    "SPELL_UPDATE_USES": {
      "owner": "SpellBookDocumentation.lua",
      "payload": [
        {
          "name": "spellID",
          "type": "number",
          "nilable": false
        },
        {
          "name": "baseSpellID",
          "type": "number",
          "nilable": true
        }
      ],
      "semantics": "spellID can be base or override; optional baseSpellID accompanies override.",
      "use": "Treat as invalidation hint. Coalesced refresh of visible count/usability faces can safely ignore both arguments."
    },
    "SPELL_UPDATE_CHARGES": {
      "owner": "SpellBookDocumentation.lua",
      "payload": [],
      "synchronous": true,
      "unique": true
    },
    "BAG_UPDATE": {
      "owner": "ContainerDocumentation.lua",
      "payload": [
        {
          "name": "bagID",
          "type": "BagIndex",
          "nilable": false
        }
      ],
      "synchronous": true
    },
    "BAG_UPDATE_DELAYED": {
      "owner": "ContainerDocumentation.lua",
      "payload": [],
      "unique": true
    },
    "C_Spell.GetSpellDisplayCount": {
      "arguments": "spellIdentifier; optional maxDisplayCount=9999, replacementString='*'",
      "returns": "string containing use count or charge count",
      "retailForever": "SecretWhenCooldownsRestricted=true; SecretArguments=AllowedWhenUntainted",
      "classicEraAnniversary": "No secret annotation at pinned definitions",
      "use": "Keep native display text opaque and write through to FontString. This task does not require an API change."
    },
    "C_Spell.GetSpellCastCount": {
      "arguments": "spellIdentifier",
      "returns": "number of casts allowed by reagents; zero for missing spell",
      "retailForever": "SecretWhenCooldownsRestricted=true; SecretArguments=AllowedWhenTainted",
      "classicEraAnniversary": "No secret annotation at pinned definitions"
    },
    "C_Spell.GetSpellCharges": {
      "arguments": "spellIdentifier",
      "returns": "SpellChargeInfo or no result for absent/non-charge spell",
      "retailForever": "SecretWhenCooldownsRestricted=true; SecretArguments=AllowedWhenTainted"
    },
    "C_ActionBar.GetActionDisplayCount": {
      "arguments": "valid actionID; optional maxDisplayCount=9999, replacementString='*'",
      "returns": "string containing use count or charges",
      "retailForever": "SecretWhenCooldownsRestricted=true; SecretArguments=AllowedWhenUntainted"
    },
    "Blizzard.ActionButton": {
      "behavior": "Shared ActionButton refreshes Count on SPELL_UPDATE_CHARGES and full Update. Neither shared code nor inspected loaded overrides register/handle SPELL_UPDATE_USES."
    },
    "Blizzard.SpellFlyout": {
      "behavior": "While visible, BAG_UPDATE refreshes shown popup counts and usability; hiding unregisters BAG_UPDATE. Uses C_Spell.GetSpellDisplayCount."
    },
    "Flux.LibClassicSpellActionCount": {
      "path": "libs/LibClassicSpellActionCount-1.0/LibClassicSpellActionCount-1.0.lua",
      "license": "MIT; retained Alexander Heubner 2019 copyright",
      "behavior": "Bundled existing library maps Light Feather reagent for Slow Fall 130 and Levitate 1706. Its item-count lookup is live; only id/name to spell identity is cached. No code imported or modified."
    }
  },
