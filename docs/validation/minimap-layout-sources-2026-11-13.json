    },
    {
      "owner": "wow-api-lua-environment / widget",
      "path": "Interface/AddOns/Blizzard_RestrictedAddOnEnvironment/SecureHandlerTemplates.xml",
      "lines": [
        6,
        13
      ],
      "contract": "SecureHandlerStateTemplate inherits explicitly protected SecureFrameTemplate and installs state-attribute handler. SecureHandler_OnLoad installs Execute/WrapScript/SetFrameRef helpers. SecureHandlers API installation refuses during combat. Restricted execution provides control handle for wrapper header and self for wrapped frame.",
      "loading": "SecureHandlers.lua then SecureHandlerTemplates.xml in the restricted-environment TOC."
    },
    {
      "owner": "wow-api-widget",
      "path": "Interface/AddOns/Blizzard_RestrictedAddOnEnvironment/RestrictedFrames.lua",
      "lines": [
        66,
        394,
