      "RegisterMenu",
      "OpenMenu",
      "DropdownButton:Pick",
      "private native configuration setters",
      "copied responders or replacement native data",
      "history reset"
    ],
    "failure": "Missing/tainted caches refuse selection with setup feedback; reload OOC and reselect."
  },
